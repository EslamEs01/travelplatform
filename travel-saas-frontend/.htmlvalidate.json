{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "prefer-native-element": "off",
    "require-sri": "off",
    "no-trailing-whitespace": "off",
    "long-title": "off",
    "meta-refresh": "off",
    "wcag/h30": "off",
    "wcag/h32": "off",
    "wcag/h36": "off",
    "wcag/h37": "off",
    "wcag/h67": "off",
    "wcag/h71": "off",
    "attr-case": ["error", { "style": "lowercase" }],
    "valid-id": "off",
    "input-missing-label": "off",
    "aria-label-misuse": "off",
    "element-permitted-content": "off",
    "script-type": "off",
    "deprecated": "warn",
    "doctype-style": ["error", { "style": "lowercase" }],
    "void-style": ["error", { "style": "selfclose" }],
    "close-order": "error",
    "no-dup-attr": "error",
    "no-dup-id": "error",
    "svg-focusable": "off",
    "heading-level": "warn",
    "no-unknown-elements": "warn",
    "attribute-allowed-values": "off",
    "no-redundant-role": "off",
    "unique-landmark": "off",
    "form-dup-name": ["error", { "shared": ["radio", "checkbox"] }]
  },
  "elements": ["html5"]
}
